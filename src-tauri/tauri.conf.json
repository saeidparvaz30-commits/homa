{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homa",
  "version": "0.1.0",
  "identifier": "com.saeid.homa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Homa",
        "width": 720,
        "height": 520,
        "visible": false,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 220,
        "height": 64,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["icons/*"]
  }
}
